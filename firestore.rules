          && incoming().ownerId == existing().ownerId
          && (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['pertanyaan', 'opsiA', 'opsiB', 'opsiC', 'opsiD', 'opsiE', 'kunci', 'pembahasan', 'kutipanMateri', 'order', 'updatedAt'])));
        allow delete: if isVerifiedSignedIn() && isValidId(cbtId) && isValidId(qId) && (existing().ownerId == request.auth.uid || isAdmin());
      }

      match /essayQuestions/{qId} {
        allow get: if isVerifiedSignedIn() && isValidId(cbtId) && isValidId(qId) && (existing().ownerId == request.auth.uid || isAdmin());
        allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
        allow create: if isVerifiedSignedIn() && isValidId(cbtId) && isValidId(qId) && isValidCbtEssayQuestion(incoming()) && isCreateTimestamps(incoming())
          && incoming().ownerId == request.auth.uid
          && existsAfter(/databases/$(database)/documents/cbtExams/$(cbtId))
          && getAfter(/databases/$(database)/documents/cbtExams/$(cbtId)).data.ownerId == request.auth.uid;
        allow update: if isVerifiedSignedIn() && isValidId(cbtId) && isValidId(qId) && isValidCbtEssayQuestion(incoming()) && isUpdateTimestamps(incoming())
          && incoming().ownerId == existing().ownerId
          && (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['pertanyaan', 'kunciRubrik', 'poinMaksimal', 'kutipanMateri', 'order', 'updatedAt'])));
        allow delete: if isVerifiedSignedIn() && isValidId(cbtId) && isValidId(qId) && (existing().ownerId == request.auth.uid || isAdmin());
      }
    }

    match /cbtResults/{resultId} {
      allow get: if isVerifiedSignedIn() && isValidId(resultId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedSignedIn() && isValidId(resultId) && isValidCbtResult(incoming()) && isCreateTimestamps(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isVerifiedSignedIn() && isValidId(resultId) && isValidCbtResult(incoming()) && isUpdateTimestamps(incoming()) && incoming().ownerId == existing().ownerId
        && (isAdmin() || (existing().ownerId == request.auth.uid && existing().statusNilai != 'Final' && incoming().diff(existing()).affectedKeys().hasOnly(['skorUraian', 'skorAkhir', 'feedbackAI', 'statusNilai', 'updatedAt'])));
      allow delete: if isVerifiedSignedIn() && isValidId(resultId) && (existing().ownerId == request.auth.uid || isAdmin());
    }

    match /staffUsers/{staffId} {
      allow get: if isVerifiedSignedIn() && isValidId(staffId) && ((resource != null && existing().ownerId == request.auth.uid) || isAdmin());
      allow list: if isVerifiedSignedIn() && (existing().ownerId == request.auth.uid || isBootstrappedAdmin());
      allow create: if isVerifiedSignedIn() && isValidId(staffId) && isValidStaffUser(incoming()) && isCreateTimestamps(incoming()) && incoming().ownerId == request.auth.uid;
      allow update: if isVerifiedSignedIn() && isValidId(staffId) && isValidStaffUser(incoming()) && isUpdateTimestamps(incoming()) && incoming().ownerId == existing().ownerId
        && (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'username', 'peran', 'kelas', 'mapel', 'kelasWali', 'kelasMengajar', 'updatedAt'])));
      allow delete: if isVerifiedSignedIn() && isValidId(staffId) && (existing().ownerId == request.auth.uid || isAdmin());
    }
  }
}
