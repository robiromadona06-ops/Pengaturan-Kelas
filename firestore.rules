      allow update: if isBootstrappedAdmin() && isValidId(adminId) && isValidAdminUser(incoming()) && isUpdateTimestamps(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']);
      allow delete: if isBootstrappedAdmin() && isValidId(adminId);
    }

    match /users/{userId} {
      allow get: if isVerifiedSignedIn() && isValidId(userId) && (userId == request.auth.uid || (resource != null && existing().ownerId == request.auth.uid) || isAdmin());
