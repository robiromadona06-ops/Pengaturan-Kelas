        && incoming().uid == existing().uid && incoming().ownerId == existing().ownerId
        && (isAdmin() || (existing().ownerId == request.auth.uid && incoming().role == existing().role && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])));
