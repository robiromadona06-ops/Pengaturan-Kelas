          && (isAdmin() || (existing().ownerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'updatedAt'])));
        allow delete: if isVerifiedSignedIn() && isValidId(userId) && isValidId(docId) && (existing().ownerId == request.auth.uid || isAdmin());
